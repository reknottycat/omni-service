[Unit]
Description=OmniService personal account bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omni
Group=omni
WorkingDirectory=/opt/omni-service
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/omni-service/.venv/bin/python -m omni_service.runtime --config /opt/omni-service/config/personal.local.json --env-file /opt/omni-service/.env.local run
Restart=on-failure
RestartSec=10
TimeoutStopSec=75
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/omni-service/var

[Install]
WantedBy=multi-user.target
